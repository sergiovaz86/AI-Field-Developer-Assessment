# Operator environment for the integrated gateway.
# This file is a template. The process does not load it automatically.
# Do not put real provider credentials in source control.

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_DATABASE_PATH=.runtime/gateway.db
GATEWAY_SQLITE_BUSY_TIMEOUT_MS=5000
GATEWAY_DEFAULT_TOKENS_PER_WINDOW=50000
GATEWAY_WINDOW_MS=60000
GATEWAY_FIRST_BYTE_TIMEOUT_MS=3000
GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS=256
GATEWAY_MAX_OUTPUT_TOKEN_BUDGET=4096
GATEWAY_LOG_LEVEL=INFO

# assessment_mock is the process default and keeps offline Task 3 completions
# available when GATEWAY_TENANT_TOKENS is unset.
# Production deployment sets this to production. Compose hardcodes that value
# on the gateway service. Incomplete production settings fail startup.
# They do not select assessment_mock, and they do not disable quota enforcement.
GATEWAY_MODE=assessment_mock

# Task 4 tenant map. Unset leaves chat completions on the Task 3 path
# while GATEWAY_MODE is assessment_mock.
# Format: tenant-name=bearer-token,tenant-name=bearer-token
# These bearers are not Task 2 admin or viewer tokens. They are not stored in SQLite.
GATEWAY_TENANT_TOKENS=

# Task 2 forwards only when the URL is set and listed exactly in the allowlist.
# Compose sets both of these to http://downstream:9000/mcp. A local process
# leaves them empty unless you export them. Tests inject an in-process client.
GATEWAY_DOWNSTREAM_MCP_URL=
GATEWAY_DOWNSTREAM_MCP_ALLOWLIST=
GATEWAY_DOWNSTREAM_TIMEOUT_MS=3000
GATEWAY_MAX_JSON_BODY_BYTES=1048576
GATEWAY_MAX_BATCH_ITEMS=32

# Chat upstream. mock is deterministic and offline.
# When GATEWAY_TENANT_TOKENS is set, a primary failure on HTTP 429, HTTP 5xx,
# a connection error, or a first-byte timeout tries the backup URL once.
# When that variable is unset, only the primary upstream is used.
GATEWAY_LLM_UPSTREAM=mock
GATEWAY_PRIMARY_PROVIDER_BASE_URL=
GATEWAY_BACKUP_PROVIDER_BASE_URL=
GATEWAY_PRIMARY_PROVIDER_API_KEY=
GATEWAY_BACKUP_PROVIDER_API_KEY=
